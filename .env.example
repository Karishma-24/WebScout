# Copy to .env and fill in. Never commit .env or put it in the submission zip.

# --- model (Groq, via its OpenAI-compatible endpoint) -----------------------
GROQ_API_KEY=your-groq-key-here
# The model is text-only: screenshots are saved for the report, never sent.
GROQ_MODEL=openai/gpt-oss-120b
# Optional. Only set these if you know you need them.
# GROQ_BASE_URL=https://api.groq.com/openai/v1
# REASONING_EFFORT=low

# --- telegram ---------------------------------------------------------------
TELEGRAM_BOT_TOKEN=your-botfather-token-here
# Optional: restrict the bot to your own Telegram user id
TELEGRAM_ALLOWED_USER_ID=

# --- run behaviour ----------------------------------------------------------
MAX_STEPS=25
HEADLESS=true
